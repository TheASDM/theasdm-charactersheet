{
  "name": "dnd-character-sheet-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for D&D Character Sheet Generator with dice rolling and character lookup",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "test": "jest"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "@prisma/client": "^5.5.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.7",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "dnd",
    "character-sheet",
    "dice-rolling",
    "ttrpg"
  ],
  "author": "Dustin Amodeo",
  "license": "MIT"
}
