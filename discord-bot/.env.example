# Discord Bot Configuration
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=your-discord-client-id-here
DISCORD_GUILD_ID=your-discord-server-id-for-testing

# API Configuration
API_BASE_URL=http://localhost:3001/api
API_KEY=your-api-key-for-backend-communication

# Database (if bot needs direct access)
DATABASE_URL="postgresql://dnd_user:password@localhost:5432/dnd_character_sheet?schema=public"

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Bot Features
ENABLE_DICE_ROLLING=true
ENABLE_CHARACTER_LOOKUP=true
ENABLE_SPELL_LOOKUP=true
ENABLE_DM_COMMANDS=true