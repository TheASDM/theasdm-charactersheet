// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

generator jsonTypes {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "raw", "ref", "canon"]
}

// Users and Authentication
enum UserRole {
  PLAYER
  DM

  @@schema("public")
}

model User {
  id                     Int       @id @default(autoincrement())
  // OAuth fields (Discord) - now optional
  discordId              String?   @unique @map("discord_id") @db.VarChar(32)
  discordAccessToken     String?   @map("discord_access_token") @db.VarChar(255)
  discordRefreshToken    String?   @map("discord_refresh_token") @db.VarChar(255)
  discordTokenExpiresAt  DateTime? @map("discord_token_expires_at")

  // Common user fields
  displayName            String    @map("display_name") @db.VarChar(100)
  username               String?   @db.VarChar(60)
  email                  String    @unique @db.VarChar(255)
  avatarUrl              String?   @map("avatar_url") @db.VarChar(255)
  role                   UserRole  @default(PLAYER) @map("role")

  // Email/Password auth fields
  passwordHash           String?   @map("password_hash") @db.VarChar(255)
  emailVerified          Boolean   @default(false) @map("email_verified")
  emailVerificationToken String?   @unique @map("email_verification_token") @db.VarChar(255)

  // Timestamps
  lastLoginAt            DateTime? @map("last_login_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  characters Character[]
  campaigns  Campaign[]

  @@map("users")
  @@schema("public")
}

// Character Management
model Character {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  name         String   @db.VarChar(100)
  level        Int      @default(1)
  characterData Json    @map("character_data")
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  isPublic     Boolean  @default(false) @map("is_public")
  campaignId   Int?     @map("campaign_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign          Campaign?               @relation(fields: [campaignId], references: [id])
  versionHistory    CharacterVersionHistory[]

  @@map("characters")
  @@schema("public")
}

// Campaign Management
model Campaign {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?
  dmId        Int      @map("dm_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  dm         User        @relation(fields: [dmId], references: [id])
  characters Character[]

  @@map("campaigns")
  @@schema("public")
}

// Content ingestion - raw + canonical architecture
enum RawContentKind {
  spell
  item
  class
  species
  background
  feat

  @@schema("raw")
}

model RawContent {
  id          BigInt   @id @default(autoincrement())
  kind        String   // RawContentKind enum doesn't exist in DB, using String
  slug        String
  source      String
  title       String
  raw         Json
  importedAt  DateTime @default(now()) @map("imported_at")
  isHomebrew  Boolean  @default(false) @map("is_homebrew")

  // Reverse relations
  canonClasses     CanonClass[]
  canonSpells      CanonSpell[]
  canonItems       CanonItem[]
  canonSpecies     CanonSpecies[]
  canonBackgrounds CanonBackground[]
  canonFeats       CanonFeat[]

  @@unique([kind, slug, source])
  @@index([kind])
  @@index([slug])
  @@index([source])
  @@map("content")
  @@schema("raw")
}

model RefSpellSchool {
  code        String @id
  name        String
  description String?

  spells CanonSpell[]

  @@map("spell_school")
  @@schema("ref")
}

model RefDamageType {
  slug        String @id
  name        String
  description String?

  spellLinks CanonSpellDamageType[]
  itemLinks  CanonItem[]

  @@map("damage_type")
  @@schema("ref")
}

model RefCondition {
  slug        String @id
  name        String
  description String?

  spellLinks CanonSpellCondition[]

  @@map("condition")
  @@schema("ref")
}

model RefCreatureType {
  slug        String @id
  name        String
  description String?

  species CanonSpecies[]

  @@map("creature_type")
  @@schema("ref")
}

model CanonClass {
  id                   BigInt   @id @default(autoincrement())
  rawContentId         BigInt   @map("raw_content_id")
  slug                 String
  name                 String
  source               String
  hitDie               Int?     @map("hit_die") @db.SmallInt
  primaryAbilities     String[] @default([]) @map("primary_abilities")
  savingThrows         String[] @default([]) @map("saving_throws")
  armorProficiencies   String[] @default([]) @map("armor_proficiencies")
  weaponProficiencies  String[] @default([]) @map("weapon_proficiencies")
  toolProficiencies    String[] @default([]) @map("tool_proficiencies")
  spellcastingAbility  String?  @map("spellcasting_ability")
  subclassTitle        String?  @map("subclass_title")
  summary              String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  raw        RawContent         @relation(fields: [rawContentId], references: [id], onDelete: Cascade)
  features   CanonClassFeature[]
  subclasses CanonSubclass[]
  spellLinks CanonSpellClass[]  @relation("ClassSpellLinks")

  @@unique([slug, source])
  @@index([name])
  @@index([source])
  @@map("class_definition")
  @@schema("canon")
}

model CanonClassFeature {
  id          BigInt   @id @default(autoincrement())
  classId     BigInt   @map("class_id")
  level       Int      @map("level") @db.SmallInt
  slug        String
  name        String
  description String
  source      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class CanonClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, slug])
  @@index([classId, level])
  @@map("class_feature")
  @@schema("canon")
}

model CanonSubclass {
  id        BigInt   @id @default(autoincrement())
  classId   BigInt   @map("class_id")
  slug      String
  name      String
  source    String
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class    CanonClass           @relation(fields: [classId], references: [id], onDelete: Cascade)
  features CanonSubclassFeature[]

  @@unique([classId, slug])
  @@map("subclass_definition")
  @@schema("canon")
}

model CanonSubclassFeature {
  id          BigInt   @id @default(autoincrement())
  subclassId  BigInt   @map("subclass_id")
  level       Int      @map("level") @db.SmallInt
  slug        String
  name        String
  description String
  source      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subclass CanonSubclass @relation(fields: [subclassId], references: [id], onDelete: Cascade)

  @@unique([subclassId, slug])
  @@map("subclass_feature")
  @@schema("canon")
}

model CanonSpell {
  id                  BigInt   @id @default(autoincrement())
  rawContentId        BigInt   @map("raw_content_id")
  slug                String
  name                String
  level               Int      @map("level") @db.SmallInt
  schoolCode          String?  @map("school_code")
  castingTime         String?  @map("casting_time")
  spellRange          String?  @map("spell_range")
  componentsVerbal    Boolean  @default(false) @map("components_verbal")
  componentsSomatic   Boolean  @default(false) @map("components_somatic")
  componentsMaterial  String?  @map("components_material")
  duration            String?
  description         String
  higherLevel         String?  @map("higher_level")
  ritual              Boolean  @default(false)
  concentration       Boolean  @default(false)
  source              String
  classes             String[] @default([])
  savingThrows        String[] @default([]) @map("saving_throws")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  raw        RawContent        @relation(fields: [rawContentId], references: [id], onDelete: Cascade)
  school     RefSpellSchool?   @relation(fields: [schoolCode], references: [code], onDelete: SetNull)
  damage     CanonSpellDamageType[]
  conditions CanonSpellCondition[]
  classLinks CanonSpellClass[] @relation("SpellClassLinks")

  @@unique([slug, source])
  @@index([name])
  @@index([level])
  @@index([source])
  @@index([schoolCode])
  @@map("spell")
  @@schema("canon")
}

model CanonSpellDamageType {
  spellId        BigInt @map("spell_id")
  damageTypeSlug String @map("damage_type_slug")

  spell      CanonSpell    @relation(fields: [spellId], references: [id], onDelete: Cascade)
  damageType RefDamageType @relation(fields: [damageTypeSlug], references: [slug], onDelete: Cascade)

  @@id([spellId, damageTypeSlug])
  @@map("spell_damage_type")
  @@schema("canon")
}

model CanonSpellCondition {
  spellId       BigInt @map("spell_id")
  conditionSlug String @map("condition_slug")

  spell     CanonSpell   @relation(fields: [spellId], references: [id], onDelete: Cascade)
  condition RefCondition @relation(fields: [conditionSlug], references: [slug], onDelete: Cascade)

  @@id([spellId, conditionSlug])
  @@map("spell_condition")
  @@schema("canon")
}

model CanonSpellClass {
  spellId BigInt @map("spell_id")
  classId BigInt @map("class_id")

  spell CanonSpell @relation("SpellClassLinks", fields: [spellId], references: [id], onDelete: Cascade)
  klass CanonClass @relation("ClassSpellLinks", fields: [classId], references: [id], onDelete: Cascade)

  @@id([spellId, classId])
  @@map("spell_class")
  @@schema("canon")
}

model CanonItem {
  id                  BigInt   @id @default(autoincrement())
  rawContentId        BigInt   @map("raw_content_id")
  slug                String
  name                String
  itemType            String?  @map("item_type")
  category            String?
  rarity              String?
  source              String
  costValue           Int?     @map("cost_value")
  costUnit            String?  @map("cost_unit")
  weight              Decimal? @map("weight") @db.Decimal
  requiresAttunement  Boolean  @default(false) @map("requires_attunement")
  attunementText      String?  @map("attunement_text")
  weaponCategory      String?  @map("weapon_category")
  damageDice          String?  @map("damage_dice")
  damageTypeSlug      String?  @map("damage_type_slug")
  itemRange           String?  @map("item_range")
  armorClass          Int?     @map("armor_class")
  acBonus             Int?     @map("ac_bonus")
  properties          String[] @default([])
  description         String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  raw        RawContent       @relation(fields: [rawContentId], references: [id], onDelete: Cascade)
  damageType RefDamageType?   @relation(fields: [damageTypeSlug], references: [slug], onDelete: SetNull)

  @@unique([slug, source])
  @@index([name])
  @@index([itemType])
  @@index([source])
  @@map("item")
  @@schema("canon")
}

model CanonSpecies {
  id             BigInt   @id @default(autoincrement())
  rawContentId   BigInt   @map("raw_content_id")
  slug           String
  name           String
  source         String
  size           String?
  speedWalk      Int?     @map("speed_walk") @db.SmallInt
  speedOther     String?  @map("speed_other")
  creatureType   String?  @map("creature_type")
  lifespan       String?
  description    String?
  languages      String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  raw             RawContent        @relation(fields: [rawContentId], references: [id], onDelete: Cascade)
  creatureTypeRef RefCreatureType?  @relation(fields: [creatureType], references: [slug], onDelete: SetNull)
  traits          CanonSpeciesTrait[]

  @@unique([slug, source])
  @@index([name])
  @@index([source])
  @@map("species_definition")
  @@schema("canon")
}

model CanonSpeciesTrait {
  id         BigInt   @id @default(autoincrement())
  speciesId  BigInt   @map("species_id")
  slug       String
  name       String
  description String
  source     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  species CanonSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([speciesId, slug])
  @@map("species_trait")
  @@schema("canon")
}

model CanonBackground {
  id                 BigInt   @id @default(autoincrement())
  rawContentId       BigInt   @map("raw_content_id")
  slug               String
  name               String
  source             String
  description        String?
  /// [SkillProficiencies]
  skillProficiencies Json?    @map("skill_proficiencies")
  /// [ToolProficiencies]
  toolProficiencies  Json?    @map("tool_proficiencies")
  /// [Languages]
  languages          Json?
  equipment          String?
  featureName        String?  @map("feature_name")
  featureDescription String?  @map("feature_description")
  originFeatSlug     String?  @map("origin_feat_slug")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  raw RawContent @relation(fields: [rawContentId], references: [id], onDelete: Cascade)

  @@unique([slug, source])
  @@index([name])
  @@index([source])
  @@map("background_definition")
  @@schema("canon")
}

model CanonFeat {
  id                 BigInt   @id @default(autoincrement())
  rawContentId       BigInt   @map("raw_content_id")
  slug               String
  name               String
  source             String
  category           String?  // Origin, General, Fighting Style, Epic Boon
  levelRequirement   Int?     @map("level_requirement") @db.SmallInt
  prerequisiteSummary String? @map("prerequisite_summary")
  repeatable         Boolean  @default(false)
  abilityScoreIncrease String? @map("ability_score_increase")
  description        String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  raw RawContent @relation(fields: [rawContentId], references: [id], onDelete: Cascade)

  @@unique([slug, source])
  @@index([name])
  @@index([source])
  @@index([category])
  @@map("feat_definition")
  @@schema("canon")
}

// Content Version Control
model ContentVersion {
  id               Int       @id @default(autoincrement())
  version          String    @db.VarChar(20)
  releaseDate      DateTime? @map("release_date")
  description      String?
  breakingChanges  Boolean   @default(false) @map("breaking_changes")
  migrationScripts Json?     @map("migration_scripts")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([version])
  @@map("content_versions")
  @@schema("public")
}

// Character Version History for Migrations
model CharacterVersionHistory {
  id             Int      @id @default(autoincrement())
  characterId    Int      @map("character_id")
  versionApplied String   @map("version_applied") @db.VarChar(20)
  appliedAt      DateTime @default(now()) @map("applied_at")
  migrationNotes String?  @map("migration_notes")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_version_history")
  @@schema("public")
}
