{
  "name": "dnd-character-sheet-backend",
  "version": "1.0.0",
  "description": "Dungeons.WTF Character Generator Backend API - D&D 2024 with Nimble TTRPG homebrew integration",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "seed": "ts-node prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "import:reference": "ts-node scripts/import/import-reference.ts",
    "import:spells": "ts-node scripts/import/import-spells.ts",
    "import:items": "ts-node scripts/import/import-items.ts",
    "import:classes": "ts-node scripts/import/import-classes.ts",
    "import:species": "ts-node scripts/import/import-species.ts",
    "import:backgrounds": "ts-node scripts/import/import-backgrounds.ts",
    "import:feats": "ts-node scripts/import/import-feats.ts",
    "import:all": "ts-node scripts/import/import-all.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "validator": "^13.15.15",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.8.10",
    "@types/supertest": "^2.0.15",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "prisma": "^6.16.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2",
    "prisma-json-types-generator": "^3.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "dnd",
    "character-sheet",
    "ttrpg",
    "api",
    "typescript",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Dustin Amodeo",
  "license": "MIT"
}
