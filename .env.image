NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Application Version
APP_VERSION=0.4.0

# Postgres connection (running in docker-compose)
DATABASE_URL="postgresql://wtforge:wtforge@postgres:5432/wtforge?schema=public"

# Frontend hits API in same container
VITE_API_URL=/api
FRONTEND_URL=https://dnd.raptornet.dev

# App secrets - ⚠️ CHANGE THESE IN PRODUCTION! ⚠️
JWT_SECRET=change_me_to_random_32_char_string
SESSION_SECRET=change_me_to_another_random_string

# Reference data seeding controls
SEED_REFERENCE=1
SEED_REFERENCE_SKIP_SPELLS=0
