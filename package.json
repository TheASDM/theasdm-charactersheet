{
  "name": "wtforge-monorepo",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --prefix backend",
    "build:client": "npm run build --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "migrate:deploy": "npm run prisma:deploy --prefix backend",
    "seed:reference": "node backend/dist/src/scripts/seed-reference.js"
  }
}
