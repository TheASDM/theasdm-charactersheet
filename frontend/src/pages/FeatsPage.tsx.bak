  color: #8b4513;
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: rgba(212, 175, 122, 0.3);
  padding: 2px 6px;
  border-radius: 3px;
  display: inline-block;
`;

const Prerequisites = styled.div`
  color: #8b4513;
  font-size: 14px;
  line-height: 1.4;
  font-weight: 600;
  font-style: italic;
  background: rgba(212, 175, 122, 0.2);
  padding: 6px 8px;
