{
  "name": "dnd-character-sheet-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "D&D 2024 Character Sheet Generator Frontend with Nimble TTRPG homebrew integration",
  "type": "module",
  "dependencies": {
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.29",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-router-dom": "^6.17.0",
    "styled-components": "^6.1.1",
    "typescript": "^5.2.2",
    "zustand": "^4.4.6"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run guardrails",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "guardrails": "bash ../scripts/guardrails/check-api-usage.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^8.52.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^0.16.5",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "dnd",
    "character-sheet",
    "ttrpg",
    "react",
    "typescript",
    "pwa"
  ],
  "author": "Dustin Amodeo",
  "license": "MIT"
}
